@model Lab0.Models.PhotoModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Dodaj zdjęcie</h2>

<form method="post" asp-action="Edit">
    <div class="mb-4">
        <label class="form-label" asp-for="Date"></label>
        <input class="form-control" asp-for="Date"/>
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="Description"></label>
        <input class="form-control" asp-for="Description"/>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="Camera"></label>
        <input class="form-control" asp-for="Camera"/>
        <span asp-validation-for="Camera" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="Author"></label>
        <input class="form-control" asp-for="Author"/>
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="Resolution"></label>
        <input class="form-control" asp-for="Resolution"/>
        <span asp-validation-for="Resolution" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label class="form-label" asp-for="Format"></label>
        <input class="form-control" asp-for="Format"/>
        <span asp-validation-for="Format" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <button type="submit" class="btn btn-primary">Aktualizuj</button>
        <button asp-action="Index" class="btn btn-outline-primary">Anuluj</button>
    </div>

</form>