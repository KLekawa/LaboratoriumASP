@model Contact

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Edytuj kontakt</h2>

<form method="post" asp-action="Edit">
    <div>
        <input asp-for="Id"/>
    </div>
    <div class="mb-2">
        <label class="form-label" asp-for="Name">Imię:</label>
        <input class="form-control" asp-for="Name"/>
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    
    <div class="mb-2">
        <label class="form-label" asp-for="Email">Email:</label>
        <input class="form-control" asp-for="Email"/>
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>
    
    <div class="mb-2">
        <label class="form-label" asp-for="BirthDate">Data urodzin</label>
        <input class="form-control" asp-for="BirthDate"/>
        <span class="text-danger" asp-validation-for="BirthDate"></span>
    </div>
    
    <div class="mb-2">
        @* <input type="button" value="Zapisz"/> *@
        <button class="btn btn-outline-primary" type="submit">Aktualizuj</button>
    </div>
    
</form>