@model List<Contact>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Kontakty</h2>
<a class="btn btn-outline-primary" asp-controller="Contact" asp-action="Create">Dodaj kontakt</a>
@if(Model.Count > 0){
    <table class="table">
        <thead>
        <th>@Html.DisplayNameFor(m => m[0].Name)</th>
        <th>@Html.DisplayNameFor(m => m[0].Email)</th>
        <th>Operacje</th>
        </thead>
        <tbody>
        @{
            foreach (var contact in Model)
            {
                <tr>
                    <td>@contact.Name</td>
                    <td>@contact.Email</td>
                    <td>
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@contact.Id">Edytuj</a>
                        <a class="btn btn-success" asp-controller="Contact" asp-action="Details" asp-route-id="@contact.Id">Szczegóły</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@contact.Id">Usuń</a>
                    </td>

                </tr>
            }
        }
        </tbody>
    </table>
}
else
{
    <h2 class="mt-4">Brak danych</h2>
}